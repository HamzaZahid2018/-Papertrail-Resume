# ResumeForge Backend Environment Variables

# Project Name
PROJECT_NAME="ResumeForge API"

# Security & JWT Configuration
# Generate a secure key in production (e.g. openssl rand -hex 32)
SECRET_KEY="supersecretsecuritykeyforresumeforgelocaldevelopmentonly"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Supabase or local PostgreSQL database connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeforge"

# CORS Configuration (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
